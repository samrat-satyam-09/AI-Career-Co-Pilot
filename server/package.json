{
  "name": "careerforu-server",
  "version": "1.0.0",
  "description": "AI Career Co-Pilot Backend — Express + TypeScript + MongoDB + Redis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:webhook": "concurrently \"npm run dev\" \"smee -u https://smee.io/6kjVLdcUZpuNSVG -p 8000 --path /api/v1/subscriptions/webhook\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^23.5.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
